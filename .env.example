# Native builds call this deployed AGYASHtv API to retrieve the operator-configured provider base address.
# Set to the production Vercel domain for local native builds.
EXPO_PUBLIC_API_ORIGIN=https://agyas-htv.vercel.app

# Configure this only in Vercel Project Settings -> Environment Variables.
# Do not put a real value in this repository or a customer APK.
# XTREAM_BASE_URL=https://provider.example:8080
