{
  "name": "agyashtv",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:web": "expo export --platform web",
    "prebuild:android": "expo prebuild --platform android --no-install",
